<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Research bench -->
	<ResearchProjectDef>
		<defName>Ferny_ResearchBench</defName>
		<label>Research bench</label>
		<description>Construct a station capable of researching technologies.</description>
		<baseCost>650</baseCost>
		<tab>Main</tab>
		<techLevel>Neolithic</techLevel>
		<researchViewX>3.00</researchViewX>
		<researchViewY>3.00</researchViewY>
		<tags>
			<li>ClassicStart</li>
		</tags>
	</ResearchProjectDef>

<!-- Sculpting bench -->
	<ResearchProjectDef>
		<defName>Ferny_SculptingBench</defName>
		<label>Sculpting bench</label>
		<description>Construct a bench capable of sculpting art.</description>
		<baseCost>400</baseCost>
		<tab>Main</tab>
		<techLevel>Neolithic</techLevel>
		<researchViewX>3.00</researchViewX>
		<researchViewY>3.00</researchViewY>
		<tags>
			<li>ClassicStart</li>
		</tags>
		<prerequisites>
			<li MayRequire="ferny.progressionfurniture">Ferny_Tables</li>
		</prerequisites>
	</ResearchProjectDef>

<!-- Electric smelter -->
	<ResearchProjectDef>
		<defName>Ferny_ElectricSmelter</defName>
		<label>Electric smelter</label>
		<description>Build an electric smelter for melting slag chunks and unwanted equipment into useful metal.</description>
		<baseCost>700</baseCost>
		<tab>Main</tab>
		<techLevel>Industrial</techLevel>
		<researchViewX>4.00</researchViewX>
		<researchViewY>3.00</researchViewY>
		<prerequisites>
			<li>Electricity</li>
			<li MayRequire="vanillaexpanded.vfeproduction">Ferny_FueledSmelter</li>
		</prerequisites>
	</ResearchProjectDef>

</Defs>