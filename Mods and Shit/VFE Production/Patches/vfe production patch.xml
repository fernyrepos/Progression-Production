		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFE_TableStonecutterElectric"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Ferny_ElectricStonecuttersTable</li>
			</researchPrerequisites>
		</value>
