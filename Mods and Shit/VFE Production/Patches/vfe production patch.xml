	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ResearchProjectDef[defName="VFE_Manufacturing"]/label</xpath>
		<value>
			<label>Large production benches</label>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
